<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde nuage et transfert d'appareil (Android 12+).
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Préférences du clavier, carnet de cartes compris -->
        <include domain="sharedpref" path="."/>

        <!-- Exclure les données sensibles -->
        <exclude domain="sharedpref" path="device.xml"/>

        <!-- Voir backup_rules.xml : ce qui a été tapé ne quitte pas
             l'appareil, pas même vers la sauvegarde du constructeur. -->
        <exclude domain="file" path="creole_dict_with_usage.json"/>
        <exclude domain="file" path="carnet_vu.json"/>
    </cloud-backup>

    <device-transfer>
        <!-- Le carnet suit le joueur d'un téléphone à l'autre -->
        <include domain="sharedpref" path="."/>

        <exclude domain="file" path="creole_dict_with_usage.json"/>
        <exclude domain="file" path="carnet_vu.json"/>
    </device-transfer>
</data-extraction-rules>
