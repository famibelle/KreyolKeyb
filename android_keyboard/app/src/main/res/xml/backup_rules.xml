<?xml version="1.0" encoding="utf-8"?>
<!--
   Sauvegarde Android jusqu'à Android 11 (au-delà, voir data_extraction_rules.xml,
   dont la section cloud dit la même chose).

   Aucune sauvegarde dans le cloud : ni réglages, ni carnet, ni progression, ni
   emojis récents. La politique de confidentialité promet que rien ne quitte
   l'appareil. Une section sans `include` sauvegarde tout par défaut, donc la
   seule façon de ne rien envoyer est d'exclure chaque domaine en entier.
   BackupRulesTest le vérifie.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
