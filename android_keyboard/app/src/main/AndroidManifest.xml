<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Deux permissions demandées, et toutes deux exercées par le code :
         la notification qui annonce un nouveau niveau de vocabulaire
         (Android 13+), et la vibration du relief des cartes du carnet.

         VIBRATE a un appelant réel depuis le carnet : KeyFeedback.onCardRidge()
         joue un cran composé sous le pouce qui traverse une carte, ce que
         performHapticFeedback ne sait pas faire (pas d'amplitude, pas de
         signe). Sans elle rien ne casse — KeyFeedback.sonder() retombe sur
         NiveauTactile.CANNED et la carte se sent comme une touche — mais le
         relief signé disparaît. Les touches du clavier, elles, n'en ont
         jamais eu besoin et n'en dépendent toujours pas.

         WRITE_USER_DICTIONARY et READ_EXTERNAL_STORAGE ont été retirées en
         10.14.3. La première servait au dictionnaire personnel de la 10.5.0,
         fonction supprimée dès la 10.6.0 ; la seconde n'a jamais eu d'appelant.
         Une permission déclarée est affichée sur la fiche Play et doit être
         justifiée dans la politique de confidentialité : en garder une dont
         aucune ligne ne se sert coûte de la confiance sans rien apporter.
         Ne pas les remettre sans un appelant réel. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="34">

        <!-- Service du clavier IME -->
        <service
            android:name=".KreyolInputMethodServiceRefactored"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Service de vérification orthographique système (spell checker) -->
        <service
            android:name=".KreyolSpellCheckerService"
            android:label="@string/spellchecker_name"
            android:permission="android.permission.BIND_TEXT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/kreyol_spellchecker" />
        </service>

        <!-- Partage de fichiers (carte de niveau) sans exposer de chemin réel -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Activity de configuration avec 4 onglets -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Réglages du clavier, atteints par l'engrenage du bandeau de
             SettingsActivity. Non exporté : rien d'extérieur n'a à ouvrir cet
             écran, et parentActivityName donne la remontée système. -->
        <activity
            android:name=".KeyboardSettingsActivity"
            android:label="Réglages du clavier"
            android:parentActivityName=".SettingsActivity"
            android:exported="false" />

    </application>

</manifest>
